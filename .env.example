# Plantilla informativa para una futura integración; no hay consumidor cloud en la app actual.
# No copiar valores reales aquí. EXPO_PUBLIC_* se incluye en el cliente y NO es secreto.

# URL del proyecto Supabase de development, solo cuando la app tenga cliente aprobado.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Clave publicable del proyecto (sb_publishable_...). Nunca service_role/secret key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
